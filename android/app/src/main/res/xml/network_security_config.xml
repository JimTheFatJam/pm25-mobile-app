<?xml version="1.0" encoding="utf-8"?>
<!-- Production traffic must use HTTPS/TLS (SRS 3.4). Cleartext HTTP is
     permitted ONLY for the Android emulator's host alias 10.0.2.2, so a
     debug build can talk to the local Flask backend (http://10.0.2.2:5050).
     Every other host stays HTTPS-only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
